# Node Agent Environment Configuration
NODE_ENV=development
PORT=5001
HOST=0.0.0.0

# Node Identifier
NODE_ID=node-sg-edge-01
NODE_REGION=Singapore

# Machine-to-Machine Secret Key (min 32 characters)
AGENT_SECRET_KEY=aston-agent-secret-key-super-secure-32chars-min

# Docker Engine Configuration
# Windows named pipe: //./pipe/docker_engine
# Linux socket: /var/run/docker.sock
# Or TCP: tcp://127.0.0.1:2375
DOCKER_SOCKET_PATH=//./pipe/docker_engine

# Storage Root for Customer Containers
DATA_ROOT_PATH=C:/aston-cloud/hosts
