# ==============================================================================
# Aston Cloud Backend Configuration
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# CORS & Security
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Logging Level
LOG_LEVEL=debug

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://aston_admin:aston_secret_pass@localhost:5432/aston_cloud_dev
PG_HOST=localhost
PG_PORT=5432
PG_USER=aston_admin
PG_PASSWORD=aston_secret_pass
PG_DATABASE=aston_cloud_dev
PG_SSL=false
PG_MAX_POOL=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000

# Redis Cache & Pub/Sub Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CONNECT_TIMEOUT_MS=5000

# Authentication & Security Secrets
JWT_SECRET=aston_cloud_super_secret_jwt_key_2026_dev_environment_min_32_chars
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Node Agent Infrastructure Client
NODE_AGENT_MODE=mock
NODE_AGENT_URL=http://127.0.0.1:5001
NODE_AGENT_KEY=aston-agent-secret-key-super-secure-32chars-min
NODE_AGENT_TIMEOUT_MS=15000
